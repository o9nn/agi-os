Package: libkoboldcpp-cog1
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Cognitive LLM inference bridge for AGI-OS
 KoboldCpp-Cog bridges KoboldCpp GGUF inference with OpenCog AtomSpace,
 providing context-aware text generation for cognitive agents.
 .
 Features:
  - AtomSpace-contextualized inference requests
  - ECAN attention-weighted context selection
  - PLN-guided prompt construction
  - OpenAI-compatible and KoboldAI native APIs
 .
 This package provides the shared library.

Package: libkoboldcpp-cog-dev
Architecture: any
Multi-Arch: same
Section: libdevel
Depends: libkoboldcpp-cog1 (= ${binary:Version}),
         libcogutil-dev,
         libatomspace-dev,
         ${misc:Depends}
Description: Cognitive LLM inference bridge - development files
 This package contains headers and development libraries for
 building applications that use KoboldCpp-Cog.

Package: koboldcpp-cog-tools
Architecture: any
Depends: libkoboldcpp-cog1 (= ${binary:Version}),
         ${shlibs:Depends}, ${misc:Depends}
Description: KoboldCpp-Cog tools and service launcher
 Contains the koboldcpp-cog-service standalone launcher and
 koboldcpp-cog-mcp MCP server for tool integration.

Package: python3-koboldcpp-cog
Architecture: all
Depends: python3, python3-requests, ${misc:Depends}
Recommends: python3-opencog
Description: Python bindings for KoboldCpp-Cog
 Python module for cognitive LLM inference via KoboldCpp,
 integrated with OpenCog AtomSpace.
