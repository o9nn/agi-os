#!/usr/bin/env python3
"""
KoboldCpp-Cog MCP Server

Exposes cognitive LLM inference as MCP tools for use in Claude Desktop,
VS Code, and other MCP clients. Bridges KoboldCpp with AtomSpace.

Usage:
    koboldcpp-cog-mcp [--endpoint URL] [--port PORT]

Environment:
    KCPP_ENDPOINT  KoboldCpp server URL (default: http://localhost:5001)
    MCP_PORT       MCP server port (default: 8100)
"""

import os
import sys
import argparse

# Add parent directory to path for imports
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'python'))

try:
    from fastmcp import FastMCP
except ImportError:
    print("Error: fastmcp not installed. Run: pip install fastmcp")
    sys.exit(1)

from koboldcpp_cog import CognitiveInference, GenerationParams

# Configuration
ENDPOINT = os.environ.get("KCPP_ENDPOINT", "http://localhost:5001")
MCP_PORT = int(os.environ.get("MCP_PORT", "8100"))

# Initialize
mcp = FastMCP("KoboldCpp-Cog: Cognitive LLM Tools", stateless_http=True)
engine = CognitiveInference(ENDPOINT)


@mcp.tool()
def cognitive_query(query: str, max_tokens: int = 256) -> str:
    """
    Answer a question using AtomSpace context and LLM inference.

    Args:
        query: The question to answer
        max_tokens: Maximum response length in tokens
    """
    params = GenerationParams(max_tokens=max_tokens)
    result = engine.infer(query, mode="query", params=params)
    return result.response_text


@mcp.tool()
def cognitive_generate(prompt: str, temperature: float = 0.8,
                       max_tokens: int = 512) -> str:
    """
    Generate content using AtomSpace seeds and LLM.

    Args:
        prompt: Generation prompt or seed text
        temperature: Creativity level (0.0-2.0)
        max_tokens: Maximum generation length
    """
    params = GenerationParams(temperature=temperature, max_tokens=max_tokens)
    result = engine.infer(prompt, mode="generate", params=params)
    return result.response_text


@mcp.tool()
def cognitive_reason(query: str) -> str:
    """
    Use LLM to assist PLN reasoning over AtomSpace knowledge.

    Args:
        query: The reasoning query
    """
    result = engine.infer(query, mode="reason")
    return result.response_text


@mcp.tool()
def cognitive_classify(text: str) -> str:
    """
    Classify text or atoms using LLM with AtomSpace context.

    Args:
        text: Text or atom description to classify
    """
    result = engine.infer(text, mode="classify")
    return result.response_text


@mcp.tool()
def cognitive_extract(text: str) -> str:
    """
    Extract structured knowledge from text into AtomSpace format.

    Args:
        text: Source text to extract knowledge from
    """
    result = engine.infer(text, mode="extract")
    return result.response_text


@mcp.tool()
def koboldcpp_status() -> str:
    """Check KoboldCpp server status and connection info."""
    if engine.is_ready():
        info = engine.client.get_info()
        return f"Connected to {engine.client.endpoint}\nModel: {info.get('model', 'unknown')}"
    else:
        return f"Not connected to {engine.client.endpoint}"


def main():
    parser = argparse.ArgumentParser(description="KoboldCpp-Cog MCP Server")
    parser.add_argument("--endpoint", default=ENDPOINT,
                        help="KoboldCpp server URL")
    parser.add_argument("--port", type=int, default=MCP_PORT,
                        help="MCP server port")
    args = parser.parse_args()

    global engine
    engine = CognitiveInference(args.endpoint)

    print(f"KoboldCpp-Cog MCP Server")
    print(f"  KoboldCpp endpoint: {args.endpoint}")
    print(f"  MCP port: {args.port}")
    print(f"  Status: {'connected' if engine.is_ready() else 'waiting for KoboldCpp'}")

    import uvicorn
    http_app = mcp.http_app(transport="streamable-http", path="/mcp")
    uvicorn.run(http_app, host="0.0.0.0", port=args.port)


if __name__ == "__main__":
    main()
